# Copy to .env. Never commit .env.

# PostgreSQL. This default matches `npm run db:local` (no Docker needed).
DATABASE_URL=postgresql://serveai:serveai@localhost:5433/serveai

# Public URL of this app; used in tracking and payment links.
APP_URL=http://localhost:3000

# Signs session JWTs. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=

# Sendiee WhatsApp API (https://docs.sendiee.com). Server-side only.
SENDIEE_API_KEY=
SENDIEE_BRAND_NUMBER=
# Shared secret you also put in the Automation Builder webhook URL/header.
SENDIEE_WEBHOOK_SECRET=

# Country code added to 10-digit local numbers.
DEFAULT_COUNTRY_CODE=91

# Payments: razorpay | stripe
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# docker-compose only: password for the bundled Postgres.
POSTGRES_PASSWORD=
